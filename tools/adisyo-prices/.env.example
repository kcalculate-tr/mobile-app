# Adisyo Internal POS API (JWT ~5 günde bir expire eder)
# Almak için: pos.adisyo.com → login → F12 → Network → herhangi bir ürünün
# fiyatını manuel değiştir → SaveProduct request → Headers
ADISYO_BEARER_TOKEN=eyJhbGciOi...
ADISYO_DEVICE_KEY=<devicekey_header_degeri>
ADISYO_RESTAURANT_ID=<restaurant_header_degeri>

# Adisyo Public External API (Supabase secrets ile aynı değerler)
ADISYO_PUBLIC_API_KEY=
ADISYO_PUBLIC_API_SECRET=
ADISYO_PUBLIC_API_CONSUMER=kcal-mobile

# Supabase service role (Dashboard → Settings → API → service_role)
SUPABASE_URL=https://xtjakvinklthlvsfcncu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
