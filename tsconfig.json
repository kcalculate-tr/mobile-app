{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "phosphor-react-native/lib/commonjs/icons/*": [
        "./node_modules/phosphor-react-native/lib/typescript/icons/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    ".expo",
    "supabase",
    "admin-panel",
    "branch-panel",
    "landing-page",
    "scripts",
    "docs/testing"
  ]
}
